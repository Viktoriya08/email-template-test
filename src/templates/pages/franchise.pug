section.page-header.page-header--info-page
	.wrapper.page-header__wrapper
		+breadcrumbs(['Главная', 'Франшиза']).page-header__breadcrumbs
		.page-header__cont
			h1.page-header__title.title.title--h1 Франшиза


section.page-section
	.wrapper
		+about('О компании', ['Это успешная и динамично развивающаяся франшиза в сфере продажи автомобильных запчастей. Компания специализируется на предоставлении широкого ассортимента запчастей для автомобилей отечественного и иностранного производства. Наша миссия – обеспечить автовладельцев Челябинска качественными запчастями по доступным ценам с удобной и быстрой доставкой.'])


section.page-section
	.wrapper
		.about.about__grid
			h2.about__title.title.title--h2 На протяжении всего периода работы нашими клиентами были
			.about__content 
				+advantages(
					[
						{
							title: 'Автосервисы и ремонтные мастерские',
							text: 'Профессионалы, занимающиеся ремонтом и техническим обслуживанием автомобилей. Они нуждаются в регулярных поставках различных запчастей и часто ищут надежные источники для закупки качественных комплектующих'
						},
						{
							title: 'Оптовые покупатели и дилеры автозапчастей',
							text: 'Компании, занимающиеся перепродажей автозапчастей. Они покупают товары в больших объемах для дальнейшей перепродажи конечным потребителям или другим предприятиям'
						},
						{
							title: 'Автодилеры и официальные представители автопроизводителей',
							text: 'Они могут приобретать запчасти для выполнения гарантийного и постгарантийного обслуживания автомобилей своих клиентов'
						}
					], "advantages--icon"
				)


section.page-section
	.wrapper
		+advantages-slider([
			{
				img: 'info-page/advantages/adv-1.svg',
				title: 'Готовая бизнес-модель и брендовое признание',
				text: 'Покупая франшизу интернет-магазина автомобильных запчастей, вы получаете доступ к уже разработанной и проверенной бизнес-модели. Это уменьшает риски и ускоряет процесс становления на рынке. Кроме того, использование узнаваемого бренда повышает доверие клиентов и способствует привлечению новой аудитории без дополнительных затрат на маркетинг и брендинг'
			},
			{
				img: 'info-page/advantages/adv-2.svg',
				title: 'Операционная поддержка и обучение',
				text: ' Франчайзеры часто предоставляют обширную поддержку в управлении бизнесом, включая обучение, маркетинговые стратегии, наставничество и техническую поддержку. Это помогает минимизировать проблемы, связанные с управлением бизнесом, и позволяет вам сосредоточиться на продажах и обслуживании клиентов'
			},
			{
				img: 'info-page/advantages/adv-3.svg',
				title: 'Доступ к проверенным поставщикам и логистическим решениям',
				text: 'Франшиза предоставляет доступ к установленным связям с поставщиками и оптимизированным логистическим цепочкам. Это означает, что вы можете предлагать клиентам широкий ассортимент качественных запчастей по конкурентоспособным ценам. Также, благодаря уже налаженным логистическим процессам, вы можете эффективно управлять запасами и доставкой, что улучшает общее качество обслуживания клиентов и повышает их удовлетворенность'
			},
			{
				img: 'info-page/advantages/adv-1.svg',
				title: 'Готовая бизнес-модель и брендовое признание',
				text: 'Покупая франшизу интернет-магазина автомобильных запчастей, вы получаете доступ к уже разработанной и проверенной бизнес-модели. Это уменьшает риски и ускоряет процесс становления на рынке. Кроме того, использование узнаваемого бренда повышает доверие клиентов и способствует привлечению новой аудитории без дополнительных затрат на маркетинг и брендинг'
			},

		])


