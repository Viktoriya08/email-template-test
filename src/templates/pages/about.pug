section.page-header.page-header--info-page
	.wrapper.page-header__wrapper
		+breadcrumbs(['Главная', 'О компании']).page-header__breadcrumbs
		.page-header__cont
			h1.page-header__title.title.title--h1 О компании


section.page-section
	.wrapper
		+about('Наша история', 
		[
			'Компания образовалась в 2009 году со стола заказов кузовных запчастей для автомобилей иностранного производства. Это был маленький бизнес с одним сотрудником. В 2010 году компания трансформируется в формат интернет-магазина с собственным сайтом и функционалом по обработке заказов. Количество поставщиков увеличивается. В этот период появляются собственные складские площади, количество сотрудников офиса и склада растет с каждым годом, клиентская база включает в себя кузовные цеха нескольких официальных дилеров, магазины запчастей, небольшие частные сервисы и розничных покупателей.', 
			'В 2016 году компания переходит на прямые поставки контейнеров от производителей Китая и Тайвани. На данный момент эти поставки отлажены и с каждым годом объем увеличивается. Логисты компании работают над ассортиментом поставок товара, который мы с удовольствием и гордостью можем предложить нашим покупателям. За время существования компании мы приобрели бесценный опыт работы с клиентами и их запросами.'
		])
		include /sections/info-pages/about-gallery


//-задачами компании были
include /sections/info-pages/advantages


//-Слайдер Преимущества
section.page-section
	.wrapper
		include /sections/info-pages/advantages-slider


//- Партнеры
section.page-section
	.wrapper
		.about-partners
			include /blocks/partners


//-Хотите стать частью команды?
include /sections/info-pages/form-team
