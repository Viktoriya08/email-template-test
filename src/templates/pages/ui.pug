								},
							])


			.pv-block
				h3.pv-block__title Tips
				.pv-block__preview
					.pv-block__items.pv-block__items--row
						.pv-block__item
							base-tooltip
								span.link Hover Me

								template(#tooltip)
									span Catch you!

						.pv-block__item
							base-tooltip(show-on-click)
								span.link Click Me

								template(#tooltip)
