section.project-view
	.wrapper
		.pv-title
			a(href=`${BASE_URL}`).pv-logo
				+image(
					{
						src: `img/logo.svg`,
						width: 270,
						height: 70,
					},
				).pv-logo__image
			h1.pv-title__text UI Kit

		ui-preview
			.pv-block
				h3.pv-block__title Breadcrumbs
				.pv-block__preview
					+breadcrumbs(["Главная", "UI"])

			.pv-block
				h3.pv-block__title Typography & Animations
				.pv-block__preview

					.pv-block__items
						.pv-block__item(v-animate="{animationClass: 'fadeInUp'}")
							h1(style="fontFamily: var(--font-family-primary); font-weight: 600; font-Size: var(--font-size-h1)") Primary Font Family - Mulish

					.pv-block__devider

					.pv-block__items(v-animate="{animationClass: 'fadeInUp'}")
						.pv-block__item
							h1.title.title--h1 Heading 1

						.pv-block__item
							h2.title.title--h2 Heading 2

						.pv-block__item
							h3.title.title--h3 Heading 3

						.pv-block__item
							h4.title.title--h4 Heading 4

						.pv-block__item
							h5.title.title--h5 Heading 5

						.pv-block__item
							h6.title.title--h6 Heading 6

					.pv-block__items.pv-block__items--row(v-animate="{animationClass: 'fadeInUp'}")
						.pv-block__item
							p(style="font-Size: var(--font-size-text-l); line-height: var(--line-height-text)") big text
						.pv-block__item
							p(style="font-Size: var(--font-size-text-m); line-height: var(--line-height-text)") regular text
						.pv-block__item
							p(style="font-Size: var(--font-size-text-s); line-height: var(--line-height-text)") caption
						.pv-block__item
							p(style="font-Size: var(--font-size-text-xs); line-height: var(--line-height-text)") small caption

			.pv-block
				h3.pv-block__title Buttons
				.pv-block__preview

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--color-primary
								+icon('arrow-left').btn__icon
								span.btn__text Button-color
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--color-primary.disabled
								span.btn__text Button-color disabled

						.pv-block__item
						button.btn.btn--color-primary.loading
								span.btn__text Button-color loading

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--color-dark
								+icon('arrow-left').btn__icon
								span.btn__text Button-color
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--color-dark.disabled
								span.btn__text Button-color disabled

						.pv-block__item
						button.btn.btn--color-dark.loading
								span.btn__text Button-color loading

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--color-light
								+icon('arrow-left').btn__icon
								span.btn__text Button-color
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--color-light.disabled
								span.btn__text Button-color disabled

						.pv-block__item
						button.btn.btn--color-light.loading
								span.btn__text Button-color loading

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--border-primary
								+icon('arrow-left').btn__icon
								span.btn__text Button-border
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--border-primary(disabled)
								span.btn__text Button-border disabled

						.pv-block__item
							button.btn.btn--border-primary.loading
								span.btn__text Button-border loading

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--transparent-color
								+icon('arrow-left').btn__icon
								span.btn__text Button-transparent
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--transparent-color.disabled
								span.btn__text Button-transparent disabled

						.pv-block__item
						button.btn.btn--transparent-color.loading
							span.btn__text Button-transparent loading

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--transparent-dark
								+icon('arrow-left').btn__icon
								span.btn__text Button-transparent
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--transparent-dark.disabled
								span.btn__text Button-transparent disabled

						.pv-block__item
						button.btn.btn--transparent-dark.loading
							span.btn__text Button-transparent loading

			.pv-block.pv-block--dark
				h3.pv-block__title Buttons Revert
				.pv-block__preview

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--color-revert
								+icon('arrow-left').btn__icon
								span.btn__text Button-color
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--color-revert.disabled
								span.btn__text Button-color disabled

						.pv-block__item
							button.btn.btn--color-revert.loading
								span.btn__text Button-color loading

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--border-revert
								+icon('arrow-left').btn__icon
								span.btn__text Button-border
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--border-revert(disabled)
								span.btn__text Button-border disabled

						.pv-block__item
							button.btn.btn--border-revert.loading
								span.btn__text Button-border loading

					.pv-block__items.pv-block__items--row
						.pv-block__item
							button.btn.btn--transparent-revert
								+icon('arrow-left').btn__icon
								span.btn__text Button-transparent
								+icon('arrow-right').btn__icon

						.pv-block__item
							button.btn.btn--transparent-revert.disabled
								span.btn__text Button-transparent disabled

						.pv-block__item
						button.btn.btn--transparent-revert.loading
							span.btn__text Button-transparent loading

			.pv-block
				h3.pv-block__title Links
				.pv-block__preview

					.pv-block__items
						.pv-block__item
							a(href="#").link Link

						.pv-block__item
							a(href="#").link.link--color Link color

						.pv-block__item
							a(href="#").link.link--color.disabled
								span.link__text Link Disabled

						.pv-block__item
							p Some text with a #[a(href="#").link.link--color link color] inside

						.pv-block__item
							a(href="#").link
								+icon('arrow-left').link__icon
								| Link with icon
								+icon('arrow-right').link__icon

						.pv-block__item
							a(href="#").link.link--color
								+icon('arrow-left').link__icon
								| Link color with icon
								+icon('arrow-right').link__icon

			.pv-block
				h3.pv-block__title Bages
				.pv-block__preview

					.pv-block__items
						.pv-block__item
							.bages
								span.bage 2 шт в наличии
								base-tooltip.bage
									span.bage__tooltip
										+icon('question').bage__icon
										| Дисконт

									template(#tooltip)
										span Дисконтный товар, это товар с небольшими визуальными дефектами, которые не влияют на работу. Благодаря этому товар может стоить дешевле.

					.pv-block__items
						.pv-block__item
							.bages
								span.bage.bage--color 2 шт в наличии
								base-tooltip.bage.bage--color
									span.bage__tooltip
										+icon('question').bage__icon
										| Дисконт

									template(#tooltip)
										span Дисконтный товар, это товар с небольшими визуальными дефектами, которые не влияют на работу. Благодаря этому товар может стоить дешевле.

					.pv-block__items
						.pv-block__item
							.bages
								span.bage.bage--small 2 шт в наличии
								base-tooltip.bage.bage--small
									span.bage__tooltip
										+icon('question').bage__icon
										| Дисконт

									template(#tooltip)
										span Дисконтный товар, это товар с небольшими визуальными дефектами, которые не влияют на работу. Благодаря этому товар может стоить дешевле.


			.pv-block
				h3.pv-block__title Dropdown
				.pv-block__preview
					.pv-block__items.pv-block__items--row
						.pv-block__item
							base-dropdown(is-fixed)
								template(#trigger)
									button.btn.btn--color-primary.btn--size-small
										span.btn__text Dropdown

								ul.dropdown__list
									li.dropdown__item
										a(href="#") Dropdown Item 1
									li.dropdown__item
										a(href="#") Dropdown Item 2
									li.dropdown__item
										a(href="#") Dropdown Item 3
			.pv-block
				h3.pv-block__title Tabs
				.pv-block__preview
					.pv-block__items
						.pv-block__item
							base-tabs(:tabs="['Tab 1', 'Tab 2', 'Tab 3']" is-hover)

						.pv-block__item
							base-tabs(:tabs="[{label: 'Tab 1', value: 'tab_1', disabled: false}, {label: 'Tab 2', value: 'tab_2', disabled: true}, {label: 'Tab 3', value: 'tab_3'}]" theme="light" )

						.pv-block__item
							base-tabs(model-value="tab_1" v-slot="{setTab, activeTab, theme}")
								li.tabs__item
									a(@click="setTab($event, 'tab_1')" href="#" :class="[{active: activeTab === 'tab_1'}, `tab--${theme}`]").tab Tab 1
								li.tabs__item
									a(@click="setTab($event, 'tab_2')" href="#" :class="[{active: activeTab === 'tab_2'}, `tab--${theme}`]").tab Tab 2
								li.tabs__item
									a(@click="setTab($event, 'tab_3')" href="#" :class="[{active: activeTab === 'tab_3'}, `tab--${theme}`]").tab Tab 3

			.pv-block
				h3.pv-block__title Accordion
				.pv-block__preview
					.pv-block__items
						.pv-block__item
							+base-accordion(
								[
									{
										title: 'Как регулируются в мире конфликты между государствами и какие организации отвечают за их решение?',
										content: 'Рост населения и экономическое развитие стран оказывают существенное влияние на мировой порядок. С ростом населения возрастает потребление природных ресурсов, что приводит к усилению экологических проблем. Экономическое развитие стран ведет к наращиванию экономической мощности и политического влияния на международной арене. Это может приводить к установлению новых правил игры в мировой экономике, заключению новых торговых, политических и военных союзов, а также изменению баланса сил между государствами. Кроме того, в условиях глобализации и международного общения различные тенденции в развитии экономики и демографии одних стран сильно влияют на другие страны.'
