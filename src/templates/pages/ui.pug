			.pv-block
				h3.pv-block__title Modals
				.pv-block__preview
					.pv-block__items.pv-block__items--row
						.pv-block__item
							button(@click="openModal('modal-confirm')").btn.btn--color-primary.btn--size-small Show

			.pv-block
				h3.pv-block__title Gallery
				.pv-block__preview
					.pv-block__items.pv-block__items--row
						.pv-block__item
							include /blocks/galleries/base-gallery
							+base-gallery(
								'gallery',
								[
									{
										img: 'https://images.unsplash.com/photo-1485204261646-2e9f783c88cd?auto=format&fit=crop&q=80&w=375&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
										width: '375',
