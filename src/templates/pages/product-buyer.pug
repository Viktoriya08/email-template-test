section.page-section.product(itemscope itemtype="https://schema.org/Product")
	.wrapper.product__wrapper
		.product__top
			+breadcrumbs(['Главная', 'Каталог', 'Hyundai', '1series E87 (04- года)', 'Бампер передний под омыв. BMW 1 Series E81 / E87 07-11 (BM04047BBV / UBH01-23320H) Тайвань']).product__breadcrumbs
			h1(itemprop="name").product__title.title.title--h2 Бампер передний под омыв. BMW 1 Series E81 / E87 07-11 (BM04047BBV / UBH01-23320H) Тайвань
			button.product__share.btn.btn--transparent-dark(@click="openModal('modal-share')")
				span.btn__text Поделиться
				+icon('share').btn__icon

		.product__cont
			.product__gallery
				include ../sections/product/product-gallery

			.product__desc
				include ../sections/product/product-desc
				include ../sections/product/product-info

			.product__info
				include ../sections/product/product-cart-buyer
				include ../sections/product/product-supplies
				include ../sections/product/product-sale

		include ../sections/product/product-sticky-buyer


include ../sections/product/products-slider-buyer

include ../sections/product/product-seo

include ../sections/product/product-form
