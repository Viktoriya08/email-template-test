section.page-header.page-header--info-page
	.wrapper.page-header__wrapper
		+breadcrumbs(['Главная', 'Оптовикам']).page-header__breadcrumbs
		.page-header__cont
			h1.page-header__title.title.title--h1 Оптовикам


section.page-section
	.wrapper
		+about()

//- Кто наш партнер?
section.page-section
	.wrapper
		.about.about__grid
			h2.about__title.title.title--h2 Кто наш партнер?
			.about__content 
				+advantages(
					[
						{
							title: 'Автосервисы и ремонтные мастерские',
							text: 'Профессионалы, занимающиеся ремонтом и техническим обслуживанием автомобилей. Они нуждаются в регулярных поставках различных запчастей и часто ищут надежные источники для закупки качественных комплектующих'
						},
						{
							title: 'Оптовые покупатели и дилеры автозапчастей',
							text: 'Компании, занимающиеся перепродажей автозапчастей. Они покупают товары в больших объемах для дальнейшей перепродажи конечным потребителям или другим предприятиям'
						},
						{
							title: 'Автодилеры и официальные представители автопроизводителей',
							text: 'Они могут приобретать запчасти для выполнения гарантийного и постгарантийного обслуживания автомобилей своих клиентов'
						},
						{
							title: 'Компании с автопарком',
							text: 'Организации, имеющие собственный парк автомобилей (например, службы доставки, такси, корпоративные автомобили), которым регулярно требуются запчасти для обслуживания и ремонта своих транспортных средств'
						}
					]
				)


//-Слайдер Преимущества
