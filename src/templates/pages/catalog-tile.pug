section.page-header
	.wrapper.page-header__wrapper
		+breadcrumbs(['Главная', 'Каталог', 'Hyundai', 'Запчасти для Hyundai Solaris 10-16']).page-header__breadcrumbs
		.page-header__cont
			h1.page-header__title.title.title--h1 Запчасти для автомобиля Hyundai Solaris 10-16
				sup.products-count.page-header__title-count 84 товара

section.page-section.catalog
	.wrapper
		.catalog__grid
			.catalog__aside
				include /sections/catalog/catalog-filters

			.catalog__container
				section.page-section.catalog__content
					include /sections/catalog/catalog-tags

					include /sections/catalog/catalog-sort

					include /sections/catalog/catalog-tile

					.page-section__pagination
						base-pagination(arrows-style="simple" :total="100" :limit="10" :max-buttons="3")

				include /sections/catalog/catalog-seo
