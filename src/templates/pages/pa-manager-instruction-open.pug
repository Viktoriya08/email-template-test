section.page-header
	.wrapper
		
		include ../sections/pa/head
		+head()

section.page-section.pa-body
	.wrapper

		.page-section__tabs.page-section__tabs--border.pa-tabs
			+pa-tabs(['Список моих клиентов', 'Список заказов моих клиентов', 'Инструкции', 'Мои данные'])

		a(href="/").pa-body__back.link
			+icon('chevron-left-md').link__icon
			| Назад к папкам

		.pa-body__title 
			h2.title.title--h3 Как работать с клиентом?
			.pa-body__count 12 файлов

		.pa-body__content
			.instructions.instructions__grid 

				- for (let i=0; i<3; i++)
					.instruction
						a(href="#" download title="").instruction__title.title.title--h6 Заголовок в две строки состоящий из нескольких слов нескольких слов нескольких слов нескольких слов
						.instruction__picture
							+icon('file-color').instruction__img-icon
						.instruction__count Документ

					.instruction
						a(href="#" download title="").instruction__title.title.title--h6 Заголовок в две строки состоящий из нескольких слов нескольких слов нескольких слов нескольких слов
						.instruction__picture
							+icon('camera').instruction__img-icon
						.instruction__count Видео

					.instruction(@click="openModal('modal-video')")
						a(href="#" title="").instruction__title.title.title--h6 Заголовок в две строки состоящий из нескольких слов нескольких слов нескольких слов нескольких слов
						.instruction__picture
							+image(
								{
									src: `img/content/standard.jpg`,
									width: '286',
									height: '192',
								},
							).instruction__img
							.instruction__play-btn.btn.btn--color-primary.btn--play
								+icon('play').btn__icon
						.instruction__count Видео

					.instruction
						a(href="#" download title="").instruction__title.title.title--h6 Заголовок в две строки состоящий из нескольких слов нескольких слов нескольких слов нескольких слов
						.instruction__picture
							+image(
								{
									src: `img/content/photo-1.jpg`,
									width: '286',
									height: '192',
								},
							).instruction__img
						.instruction__count Документ


	.page-section__pagination
		base-pagination(arrows-style="simple" :total="100" :limit="15" :max-buttons="5")
