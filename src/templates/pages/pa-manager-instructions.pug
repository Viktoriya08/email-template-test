section.page-header
	.wrapper
		
		include ../sections/pa/head
		+head()

section.page-section.pa-body
	.wrapper

		.page-section__tabs.page-section__tabs--border.pa-tabs
			+pa-tabs(['Список моих клиентов', 'Список заказов моих клиентов', 'Инструкции', 'Мои данные'])


		.pa-body__title 
			h2.title.title--h3 Инструкции
			.pa-body__count 10 папок

		.pa-body__content
			.instructions.instructions__grid 

				- for (let i=0; i<10; i++)
					.instruction
						a(href="#").instruction__title.title.title--h6 Заголовок в две строки состоящий из нескольких слов нескольких слов нескольких слов нескольких слов
						.instruction__img 
							+icon('folder').instruction__img-icon
						.instruction__count 5 файлов


	.page-section__pagination
		base-pagination(arrows-style="simple" :total="100" :limit="15" :max-buttons="5")
