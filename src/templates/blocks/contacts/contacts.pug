.contacts
	address.contacts__list(itemscope itemtype="http://schema.org/LocalBusiness")
		.contacts__item
			.contacts-label
				+icon('pin').contacts-label__icon
				span.contacts-label__text Наш адрес

			.contacts-cont
				.contacts-cont__el
					span(itemprop="address" itemscope itemtype="http://schema.org/PostalAddress")
						meta(itemprop="addressCountry" content="Россия")
						meta(itemprop="addressLocality" content="Челябинск")
						meta(itemprop="streetAddress" content="ул.Косарева 2, корпус 2, офис 301 (2 этаж)")
						| Россия, г.&nbsp;Челябинск, ул.Косарева&nbsp;2, корпус&nbsp;2, <br> офис&nbsp;301 (2&nbsp;этаж)

		.contacts__item
			.contacts-label
				+icon('clock').contacts-label__icon
				span.contacts-label__text Режим работы

			.contacts-cont
				.contacts-cont__el
					time(itemprop="openingHours" datetime="Mo-Fr, 9:30−18:00") Пн-пт: с 09:30 до 18:00

				.contacts-cont__el
					time(itemprop="openingHours" datetime="Sa, 9:30−14:00") Суббота: с 09:30 до 14:00

				.contacts-cont__el
					time(itemprop="openingHours" datetime="Su, day off") Воскресенье: выходной

		.contacts__item
			.contacts-label
				+icon('phone').contacts-label__icon
				span.contacts-label__text Телефон

			.contacts-cont
				.contacts-cont__el
					a(href="tel:+73517299300" itemprop="telephone").link.link--color 8 351 729-93-00
					span.contacts-cont__info (многоканальный)

				.contacts-cont__el
					a(href="tel:+79058383961" itemprop="telephone").link.link--color 8 905 838-39-61
					span.contacts-cont__info (многоканальный)

				.contacts-cont__el
					a(href="tel:+79682100354" itemprop="telephone").link.link--color 8 968 210-03-54
					.contacts-cont__socials
						a(href="#" itemprop="sameAs").link.link--color
							| Telegram
							+icon('telegram').link__icon
						a(href="#" itemprop="sameAs").link.link--color
							| WhatsApp
							+icon('whatsapp').link__icon
						a(href="#" itemprop="sameAs").link.link--color
							| Viber
							+icon('viber').link__icon

		.contacts__item
			.contacts-label
				+icon('mail').contacts-label__icon
				span.contacts-label__text Электронная почта

			.contacts-cont
				.contacts-cont__el
					a(href="mailto:info@ua74.ru" itemprop="email").link info@ua74.ru

				.contacts-cont__el
					a(href="mailto:uralauto74@gmail.com" itemprop="email").link uralauto74@gmail.com
