mixin staff(title, cards=[], mode="")

	.staff
		if title
			h2.title.title--h2.staff__title(class=`${mode}`)!=title

		.staff__grid 

			each item in cards
				.staff__card 
					.staff__box
						.staff__photo 
							if item.img
								+image(
									{
										src: `img/info-page/staff/${item.img}`,
										width: 120,
										height: 120,
									}
								).staff__photo-img

						.title.title--h5.staff__name=item.name 
						.staff__text=item.text 
					.staff__contacts 
						a(href="mailto:")=item.email 

						if item.phones
							.staff__phones 
								each el in item.phones
									a(href="tel:+")=el
