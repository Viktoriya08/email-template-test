mixin media-gallery(id, items = [])
	base-gallery(gallery-id=`${id}`)
		template(#default)
			.media-gallery(id=`${id}`)&attributes(attributes)
				each item in items
					a.media-gallery__item(href=`${item.img}` data-pswp-width=`500` data-pswp-height=`300` target="_blank")
						+image(
							{
								src: `img/${item.img}`,
								width: item.width,
								height: item.height,
							},
						)
