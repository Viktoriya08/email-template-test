.catalog-brands__mobile
	.catalog-brands__rows
		.catalog-brands__row
			.brands-tabs
				tabs-template
					template(#tabs="{changeTab}")
						brands-tabs(
							:tabs="[{label: 'A', value: 'A'}, {label: 'B', value: 'B'}, {label: 'C', value: 'C'}, {label: 'D', value: 'D'}, {label: 'F', value: 'F'}]"
							@change="changeTab")

					template(#content="{currentTab}")
						.catalog-brands__group-list(v-show="currentTab === 'A'")
							a(href="#").catalog-brands__group-el.link Acura
							a(href="#").catalog-brands__group-el.link Audi

						.catalog-brands__group-list(v-show="currentTab === 'B'")
							a(href="#").catalog-brands__group-el.link Bmw

						.catalog-brands__group-list(v-show="currentTab === 'C'")
							a(href="#").catalog-brands__group-el.link Changan
							a(href="#").catalog-brands__group-el.link Chery
							a(href="#").catalog-brands__group-el.link Chevrolet
							a(href="#").catalog-brands__group-el.link Chrysler
							a(href="#").catalog-brands__group-el.link Citroen

						.catalog-brands__group-list(v-show="currentTab === 'D'")
							a(href="#").catalog-brands__group-el.link Daewoo
							a(href="#").catalog-brands__group-el.link Daihatsu
							a(href="#").catalog-brands__group-el.link Datsun
							a(href="#").catalog-brands__group-el.link Dodge

						.catalog-brands__group-list(v-show="currentTab === 'F'")
							a(href="#").catalog-brands__group-el.link Fiat
							a(href="#").catalog-brands__group-el.link Ford

