mixin error-block(title, texts, list, buttonText, img)
	section.section.error-block
		.wrapper
			.error-block__wrapper
				.error-block__info
					h1.error-block__title.title.title--h1!=title
					.error-block__desc
						if texts
							each item in texts
								p!=item

						if list
							ul
								each item in list
									li!=item

				a(href="/").btn.btn--color-primary.error-block__btn
					span.btn__text=buttonText

				+image(
					{
						src: `img/${img}`,
						width: 470,
						height: 200,
					},

				).error-block__img
