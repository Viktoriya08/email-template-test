//- Personal
//- Ваши данные
tr
	td.personal
		table(border="0" cellspacing="0" cellpadding="0" role="presentation" style="width: 100%;")
			thead
				tr
					td.personal__head-td.personal__title
						p Отсутствие прехедера в вёрстке
			tr
				td.personal__elem
					table(border="0" cellspacing="0" cellpadding="0" role="presentation")
						tr
							td.personal__elem-td(width="36")

								table.personal__elem-number-box(border="0" cellspacing="0" cellpadding="0" role="presentation")
									tr
										td.personal__elem-number
											img.personal__elem-number-img(src="https://viktoriya08.github.io/email-template-test/dist/img/1.png" alt="цифра номер 1" border="0" width="36")

							td.personal__elem-text
								p Не все бренды уделяют внимание прехедеру.

			tr
				td.personal__elem
					table(border="0" cellspacing="0" cellpadding="0" role="presentation")
						tr
							td.personal__elem-td(width="36")

								table.personal__elem-number-box(border="0" cellspacing="0" cellpadding="0" role="presentation")
									tr
										td.personal__elem-number
											img.personal__elem-number-img(src="https://viktoriya08.github.io/email-template-test/dist/img/2.png" alt="цифра номер 2" border="0" width="36")

							td.personal__elem-text
								p Использовать прехедер или нет — выбор маркетолога.

			tr
				td.personal__elem
					table(border="0" cellspacing="0" cellpadding="0" role="presentation")
						tr
							td.personal__elem-td(width="36")

								table.personal__elem-number-box(border="0" cellspacing="0" cellpadding="0" role="presentation")
									tr
										td.personal__elem-number
											img.personal__elem-number-img(src="https://viktoriya08.github.io/email-template-test/dist/img/3.png" alt="цифра номер 3" border="0" width="36")

							td.personal__elem-text
								p Если не прописать в вёрстке прехедер (в том числе нулевой), то на его место подтянутся первые слова письма.
