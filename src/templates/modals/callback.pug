base-modal(id="modal-callback")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Связаться с нами

				p.modal__text Укажите свой номер. Мы свяжемся с&nbsp;вами в&nbsp;ближайшее время.

				.modal__form
					callback-form

				.modal__bottom
					.modal__contacts
						span.modal__contacts-title Свяжитесь с нами
						a(href="tel:+73517299300").modal__contacts-link.link.link--color 8 351 729-93-00
