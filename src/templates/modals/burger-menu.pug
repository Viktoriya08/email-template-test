menu-modal(id="modal-menu")
	template(#default="{close}")
		section.burger-menu
			.burger-menu__header
				.wrapper.burger-menu__header-wrapper
					a(href="#").burger-menu__logo.logo
						+image(
							{
								src: 'img/logo.svg',
								alt: 'KuzovProject',
								width: '259',
								height: '42'
							}
						).logo__img

					button(@click="close").burger.burger-menu__close
						+icon('close').burger__icon.burger__icon--close

			.burger-menu__cont
				.wrapper.burger-menu__cont-wrapper
					.burger-menu__search.search
						search-header-form

					.burger-menu__item
						.burger-menu__city-toggle.city-toggle
							span.city-toggle__label Ваш город

							base-dropdown(is-fixed).city-toggle__dropdown
								template(#trigger)
									button.btn.btn--transparent-dark
										span.btn__text Челябинск
										+icon('arrow-small-down').btn__icon.dropdown__icon

								ul.dropdown__list
									li.dropdown__item
										a(href="#" download).link Челябинск
									li.dropdown__item
										a(href="#" download).link Екатеринбург
									li.dropdown__item
										a(href="#" download).link Пермь

					.burger-menu__item
						nav.main-menu(itemscope itemtype="http://schema.org/SiteNavigationElement")
							a(href="#" itemprop="url").main-menu__link.link.link--color Каталог

							each link, i in ['Контакты', 'Оптовикам', 'Вакансии', 'Оплата и возврат', 'Популярные вопросы', 'О компании', 'Медиа', 'Партнеры', 'Связаться с руководством', 'For suppliers']
								a(href="#" itemprop="url").main-menu__link.link.link=link

					.burger-menu__item
						.burger-menu__actions
							a(href="#").burger-menu__actions-el.btn.btn--transparent-dark
								+icon('user').btn__icon
								span.btn__text Личный кабинет

							button.burger-menu__actions-el.btn.btn--transparent-dark
								span.btn__text Выйти из аккаунта
								+icon('logout').btn__icon

					.burger-menu__item
						.burger-menu__actions
							button(@click="openModal('modal-supplies')").burger-menu__actions-el.btn.btn--transparent-dark
								+icon('shipping').btn__icon
								span.btn__text Ожидаемые поставки
							a(href="#" download).burger-menu__actions-el.btn.btn--transparent-dark
								+icon('file').btn__icon
								span.btn__text Скачать прайс

						.burger-menu__contacts
							a(href="tel:+73517299300").burger-menu__contacts-el.btn.btn--transparent-color
								+icon('phone').btn__icon
								span.btn__text 8 351 729-93-00

							button(@click="openModal('modal-callback')").burger-menu__contacts-el.btn.btn--border-primary
								span.btn__text Связаться с нами

