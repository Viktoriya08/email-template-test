base-modal(id="modal-confirm")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Ваш запрос успешно отправлен, мы свяжемся с вами в ближайшее время

				p.modal__text Ожидайте звонка менеджера в ближайшее время

				.modal__bottom
					.modal__buttons
						button(@click="close").btn.btn--color-primary
							span.btn__text Понятно
