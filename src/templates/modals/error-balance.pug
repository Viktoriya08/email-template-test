base-modal(id="modal-error-balance")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Сообщить об ошибке в балансе

				p.modal__text Если вы заметили, что данные о балансе не&nbsp;актуальны, сообщите об этом нам, и мы свяжемся с&nbsp;вами&nbsp;для решения вопроса

				.modal__bottom.modal__buttons
					button.btn.btn--border-primary(@click="close")
						span.btn__text Не сообщать
					button.btn.btn--color-primary
						span.btn__text Сообщить об ошибке
