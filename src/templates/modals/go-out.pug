base-modal(id="modal-go-out")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Вы уверены, что хотите выйти?

				p.modal__text Вы не сможете пользоваться всеми функциями сайта, если выйдете из вашего личного профиля

				.modal__bottom.modal__buttons
					button.btn.btn--border-primary(@click="close")
						span.btn__text Нет, остаться
					button.btn.btn--color-primary
						span.btn__text Да, выйти
