base-modal(id="modal-gallery")
	template(#default="{close}")
		section.modal.modal--gallery.modal-gallery
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper.modal-gallery__wrapper
				media-gallery-slider
					template(#default)

						.swiper-slide
							+image(
								{
									src: `img/content/gallery-1.webp`,
									width: 900,
									height: 506,
								},
							).modal-gallery__img

						.swiper-slide
							+image(
								{
									src: `img/content/gallery-2.webp`,
