base-modal(id="modal-password-pa")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Ваш пароль успешно изменен

				p.modal__text Пароль был успешно изменен

				.modal__bottom
					.modal__buttons
						button(@click="close").btn.btn--color-primary
							span.btn__text Понятно
