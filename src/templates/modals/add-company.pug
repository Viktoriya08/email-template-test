base-modal(id="modal-add-company")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Вы уверенны, что хотите отправить запрос на добавление юр. лица?

				p.modal__text После отправки запроса, наш менеджер свяжется с&nbsp;вами&nbsp;в ближайшее время для изменения данных о зарегистрированных юр. лицах

				.modal__bottom.modal__buttons
					button.btn.btn--border-primary(@click="close")
						span.btn__text Нет, не отправлять
					button.btn.btn--color-primary.modal__btn.modal__btn--grow
						span.btn__text Да, отправить запрос
