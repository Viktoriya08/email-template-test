base-modal(id="modal-supplies")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Ожидаемые поставки

				ul.supplies-list
					li.supplies-list__item
						a(href="#" download).link Тайвань - 15.02.2024
					li.supplies-list__item
						a(href="#" download).link Тайвань - 20.02.2024
					li.supplies-list__item
						a(href="#" download).link Китай - 26.02.2024

				.modal__bottom
					.modal__buttons
						button(@click="close").btn.btn--color-primary
							span.btn__text Закрыть
