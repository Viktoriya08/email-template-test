base-modal(id="modal-application-pa")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Ваша заявка успешно отправлена

				p.modal__text Ваша заявка успешно отправлена, в ближайшее время с вами свяжется наш менеджер

				.modal__bottom
					.modal__buttons
						button(@click="close").btn.btn--color-primary
							span.btn__text Понятно
