base-modal(id="modal-video")
	template(#default="{close}")
		section.modal.modal--gallery.modal-gallery
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper.modal-gallery__wrapper
				base-video.modal-gallery__video
					template(#default="{canPlayHandler, errorHandler}")
						video(poster=`https://html.xpager.ru/kuzovproject/img/content/standard.jpg` loop preload="metadata" @canplay="canPlayHandler" @error="errorHandler").video__video
							source(src="https://www.shutterstock.com/shutterstock/videos/1075356548/preview/stock-footage-ice-hockey-rink-arena-professional-forward-player-breaks-defense-hitting-puck-with-stick-scores.mp4" type="video/mp4")
							source(src="https://www.shutterstock.com/shutterstock/videos/1075356548/preview/stock-footage-ice-hockey-rink-arena-professional-forward-player-breaks-defense-hitting-puck-with-stick-scores.webm" type="video/webm")


