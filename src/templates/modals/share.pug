base-modal(id="modal-share")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title.title.title--h4 Поделиться
				.modal__text Вы можете поделиться ссылкой в&nbsp;социальных сетях или&nbsp;скопировать ссылку

				.modal__share.share-block.share-block--col

					.share-block__social
						ul.share-block__list
							li.share-block__item
								a(href="#", target="_blank" title="Telegram").share-block__link
									+icon('telegram').share-block__link-icon
							li.share-block__item
								a(href="#", target="_blank" title="WhatsApp").share-block__link
									+icon('whatsapp').share-block__link-icon
							li.share-block__item
								a(href="#", target="_blank" title="Viber").share-block__link
									+icon('viber').share-block__link-icon

					.share-block__copy.share-block__copy--col
						.share-block__url
							span.share-block__url-text https://ua74.ru/
						share-link(#default="{link, copyLink}")
							button.btn.btn--color-primary.share-block__btn(@click="copyLink('Ссылка успешно скопирована')") Скопировать ссылку
