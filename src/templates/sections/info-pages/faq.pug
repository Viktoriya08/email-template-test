.faq.faq__grid 

	//- для for-suppliers.html
	if suppliers

		h2.about__title.title.title--h2 FAQ

		.faq__content 
			+base-accordion(
				[
					{
						title: 'Can I use the warranty or service services at any franchise store in the network if I purchased a spare part at another franchise store?',
						content: 'Yes, warranty service and support apply to all franchise stores in our network. If you have problems with a spare part purchased from one of our franchise stores, you can contact any other store in the network for assistance or exchange of goods under warranty.'
					},
					{
						title: 'Are there differences in assortment and prices between the main online store and its franchises?',
						content: 'Yes, warranty service and support apply to all franchise stores in our network. If you have problems with a spare part purchased from one of our franchise stores, you can contact any other store in the network for assistance or exchange of goods under warranty.'
					},
					{
						title: 'Can I place an order at one franchise store and pick it up at another?',
						content: 'Yes, warranty service and support apply to all franchise stores in our network. If you have problems with a spare part purchased from one of our franchise stores, you can contact any other store in the network for assistance or exchange of goods under warranty.'
					},
				]
			)(theme="backdrop")

	//- 
	else

		h2.about__title.title.title--h2 Частые вопросы

		.faq__content 
			+base-accordion(
				[
					{
						title: 'Могу ли я воспользоваться гарантией или сервисными услугами в любом франшизном магазине сети, если я приобрел запчасть в другом франчайзи-магазине?',
						content: 'Да, гарантийное обслуживание и поддержка распространяются на все франшизные магазины в нашей сети. Если у вас возникнут проблемы с запчастью, купленной в одном из наших франшизных магазинов, вы можете обратиться в любой другой магазин сети для получения помощи или обмена товара в рамках гарантийных обязательств.'
					},
					{
						title: 'Есть ли различия в ассортименте и ценах между основным интернет-магазином и его франшизами?',
						content: 'Рост населения и экономическое развитие стран оказывают существенное влияние на мировой порядок. С ростом населения возрастает потребление природных ресурсов, что приводит к усилению экологических проблем. Экономическое развитие стран ведет к наращиванию экономической мощности и политического влияния на международной арене. Это может приводить к установлению новых правил игры в мировой экономике, заключению новых торговых, политических и военных союзов, а также изменению баланса сил между государствами. Кроме того, в условиях глобализации и международного общения различные тенденции в развитии экономики и демографии одних стран сильно влияют на другие страны.'
					},
					{
						title: 'Можно ли оформить заказ в одном франшизном магазине и забрать его в другом?',
						content: 'Рост населения и экономическое развитие стран оказывают существенное влияние на мировой порядок. С ростом населения возрастает потребление природных ресурсов, что приводит к усилению экологических проблем. Экономическое развитие стран ведет к наращиванию экономической мощности и политического влияния на международной арене. Это может приводить к установлению новых правил игры в мировой экономике, заключению новых торговых, политических и военных союзов, а также изменению баланса сил между государствами. Кроме того, в условиях глобализации и международного общения различные тенденции в развитии экономики и демографии одних стран сильно влияют на другие страны.'
					},
				]
			)(theme="backdrop")
