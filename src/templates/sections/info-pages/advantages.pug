section.page-section
	.wrapper
		.about.about__grid

			//- для for-suppliers.html
			if suppliers
				h2.about__title.title.title--h2 Throughout the entire period of operation, the main objectives of the company were
				.about__content 
					+advantages(
						[
							{
								title: 'Worthy choice ',
								text: 'To provide the buyer with a worthy choice with an optimal price/quality ratio of body parts, optics, mirrors, radiators'
							},
							{
								title: 'Convenient functional',
								text: 'Offer a convenient functional service for purchasing parts and transporting them to the client'
							},
							{
								title: 'Qualified selection',
								text: 'Qualified selection of parts by experienced managers'
							}
						], "advantages--icon"
					)
			//-
			else

				h2.about__title.title.title--h2 На протяжении всего периода работы основными задачами компании были
				.about__content 
					+advantages(
						[
							{
								title: 'Достойный выбор',
								text: 'Предоставить покупателю достойный выбор по оптимальному соотношению “цена/качество” кузовных деталей, оптики, зеркал, радиаторов'
							},
							{
								title: 'Удобный функционал',
								text: 'Предложить удобный функционал-сервис для приобретения детали и ее транспортировки до клиента'
							},
							{
								title: 'Индивидуальный подбор',
								text: 'Предложить удобный функционал-сервис для приобретения детали и ее транспортировки до клиента'
							}
						], "advantages--icon"
					)
