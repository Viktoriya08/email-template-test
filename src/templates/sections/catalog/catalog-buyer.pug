.catalog-discount.catalog-discount--mob
	base-dropdown(is-fixed).catalog-discount__dropdown
		template(#trigger)
			button.catalog-discount__bage.bage.bage--small
				| Размер скидки: 25%
				+icon('arrow-md-down').bage__icon.dropdown__icon

		ul.dropdown__list
			li.dropdown__item
				a(href="#").link.active Размер скидки: 25%
			li.dropdown__item
				a(href="#").link Размер скидки: 15%
			li.dropdown__item
				a(href="#").link Размер скидки: 10%

table.catalog-table
	thead.catalog-table__head
		tr.catalog-table__row
			td.catalog-table__col
				.catalog-table__title Наименование
			td.catalog-table__col
				.catalog-table__title Номер
			td.catalog-table__col
				.catalog-table__title Ориг. номер
			td.catalog-table__col
				.catalog-table__title Наличие
			td.catalog-table__col
				.catalog-table__title Скидка
				.catalog-discount
					base-dropdown(is-fixed).catalog-discount__dropdown
						template(#trigger)
							button.catalog-discount__bage.bage.bage--small
								| 25%
								+icon('arrow-md-down').bage__icon.dropdown__icon

						ul.dropdown__list
							li.dropdown__item
								a(href="#").link.active 25%
							li.dropdown__item
								a(href="#").link 15%
							li.dropdown__item
								a(href="#").link 10%
							li.dropdown__item
								a(href="#").link 5%
							li.dropdown__item
								a(href="#").link 0%

			td.catalog-table__col
				.catalog-table__title Цена

	tbody.catalog-table__body
		tr.catalog-table__row.product-card.product-card--row
			td.catalog-table__col
				.product-card__top
					+image({
						src: 'img/catalog/product-1.webp',
						width: '268',
						height: '164'
					}).product-card__img.product-card__img--mini(@click="openModal('modal-gallery')" data-gallery)

					.product-card__desc
						span.product-card__name Бампер передний под омыв. BMW 1 Series E81 / E87 07-11 (BM04047BBV / UBH01-23320H) Тайвань
						span.product-card__info TYG-Тайвань

			td.catalog-table__col.catalog-table__col--desc
				span.product-card__number HN04099BB

			td.catalog-table__col.catalog-table__col--desc
				span.product-card__original AN04099BB

			td.catalog-table__col.catalog-table__col--desc
				span.product-card__availability 565

			td.catalog-table__col.catalog-table__col--desc
				span.product-card__discount 2 360 ₽

			td.catalog-table__col
				.product-card__actions.product-card__actions--row
					.product-card__price.price
						.price__item.price__item--old
							span.price__item-price 212 360
							span.price__item-currency ₽
						.price__item.price__item--current
							span.price__item-price 210 000
							span.price__item-currency ₽

					.product-card__btns.product-card__btns--col
						.product-card__supplies.product-card__supplies--desc
							span.product-card__supplies-title Поставки:
							a(href="#").product-card__supplies-el 20.05.2024 - 1 шт
							span.product-card__supplies-el 21.05.2024 - 2 шт
							span.product-card__supplies-el 22.05.2024 - 3 шт

				a(href="#").product-card__link

		tr.catalog-table__row.product-card.product-card--row
			td.catalog-table__col
				.product-card__top
					+image({
						src: 'img/catalog/product-temp-sm.svg',
						width: '268',
						height: '164'
					}).product-card__img.product-card__img--mini

					.product-card__desc
