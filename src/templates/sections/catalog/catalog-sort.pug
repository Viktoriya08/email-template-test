.catalog-sort
	.catalog-sort__list
		.catalog-sort__item
			base-dropdown(is-fixed).catalog-sort__dropdown
				template(#trigger)
					button.btn.btn--transparent-dark
						span.btn__text Популярные
						+icon('arrow-md-down').btn__icon.dropdown__icon

				ul.dropdown__list
					li.dropdown__item
						a(href="#").link.active Популярные
					li.dropdown__item
						a(href="#").link Сначала дешевые
					li.dropdown__item
						a(href="#").link Сначала дорогие

		.catalog-sort__item.catalog-sort__item--desc
			input-checkbox(id="availability" text="Только товары в наличии").catalog-sort__checkbox

		.catalog-sort__item.catalog-sort__item--desc
			input-checkbox(id="discount" text="Только дисконтные товары").catalog-sort__checkbox

	.catalog-sort__actions
		.catalog-sort__view
			button.catalog-sort__view-el.active
				+icon('tile').catalog-sort__view-icon
			button.catalog-sort__view-el
				+icon('list').catalog-sort__view-icon

		button(@click="openModal('filters-modal')").catalog-sort__filters.btn.btn--transparent-color
			+icon('filter').btn__icon
