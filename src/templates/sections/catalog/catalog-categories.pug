.categories
	.categories__list.categories__list--inner
		each category, i in ['Бамперы', 'Капоты', 'Крылья', 'Фары', 'Радиаторы', 'Бачки']
			.categories__item.category-card
				+image(
					{
						src: 'img/catalog/category-'+(i + 1)+'.webp',
						width: 162,
						height: 108,
					}
				).category-card__img
				span.category-card__name=category
				a(href="#").category-card__link=category

		each category, i in ['Брызговик', 'Заглушка', 'Подкрылок', 'Защита двигателя', 'Зеркало', 'Стоп сигнал']
			.categories__item.category-card
				+image(
					{
						src: 'img/catalog/category-'+(i + 1)+'.webp',
						width: 162,
						height: 108,
					}
				).category-card__img
				span.category-card__name=category
				a(href="#").category-card__link=category

		each category, i in ['Дверь', 'Лампы', 'Клипсы', 'Решетка радиатора', 'Диффузор', 'Крышка багажника']
			.categories__item.category-card
				+image(
					{
						src: 'img/catalog/category-'+(i + 1)+'.webp',
						width: 162,
						height: 108,
					}
				).category-card__img
				span.category-card__name=category
				a(href="#").category-card__link=category

		each category, i in ['Крепление бампера', 'Рамка радиатора', 'Противотуманная фара', 'Поворотник', 'Пробка радиатора']
			.categories__item.category-card
				+image(
					{
						src: 'img/catalog/category-'+(i + 1)+'.webp',
						width: 162,
						height: 108,
					}
				).category-card__img
				span.category-card__name=category
				a(href="#").category-card__link=category
