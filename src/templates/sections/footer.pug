mixin footer(isMain=false)
	footer.footer
		.wrapper
			.footer__cont
				.footer__nav.footer-menu
					ul.footer-menu__list
						li.footer-menu__item
							a(href="#").footer-menu__link.title.title--h5 Каталог

							ul.footer-submenu
								each link, i in ['Бамперы', 'Фары', 'Радиаторы', 'Капот', 'Дисконт']
									li.footer-submenu__item
										a(href="#").footer-submenu__link=link

					ul.footer-menu__list
						each link, i in ['О компании', 'Оптовикам', 'Контакты', 'Оплата и возврат', 'Популярные вопросы']
							li.footer-menu__item
								a(href="#").footer-menu__link.title.title--h5=link

					ul.footer-menu__list
						each link, i in ['Партнеры', 'Медиа', 'Вакансии', 'For suppliers', 'Связаться с руководством']
							li.footer-menu__item
								a(href="#").footer-menu__link.title.title--h5=link

				.footer__contacts.footer-contacts
					.footer-contacts__item.footer-contacts__item--color
						.footer-contacts__item-title.title.title--h5 Свяжитесь с&nbsp;нами
						.footer-contacts__item-text Оставьте заявку. <br> Мы свяжемся с&nbsp;вами в&nbsp;ближайшее время
						button(@click="openModal('modal-callback')").footer-contacts__item-btn.btn.btn--color-revert
							span.btn__text Связаться с нами

					.footer-contacts__item.footer-contacts__item--all
						include /blocks/contacts/contacts

					.footer-contacts__item
						.footer-contacts__item-title.title.title--h5 Все цены в&nbsp;одном месте
						.footer-contacts__item-text Скачайте наш&nbsp;прайс, чтобы он&nbsp;всегда был под&nbsp;рукой
						a(href="#" download).footer-contacts__item-btn.btn.btn--color-light
							span.btn__text Скачать прайс

				if isMain
					.footer__text
						h3.footer__text-title.title.title--h5 Интернет-магазин автозапчастей

						p kuzovproject.ru - интернет-магазин, занимающийся розничной продажей кузовных запчастей и комплектующих для легковых автомобилей иностранного и российского производства.
						p Мы предлагаем быстрый и удобный сервис по поиску, подбору и заказу необходимых вам запчастей, одни из самых конкурентных цен на рынке и&nbsp;максимально короткие сроки доставки.

			.footer__partners
				include /blocks/partners

			.footer__bottom(itemscope itemtype="http://schema.org/WPFooter")
				meta(itemprop="copyrightYear" content="2024")
				.footer__copyright &copy; 2024 «Kuzovproject»

				.footer__links
					a(href="#").footer__links-el.link.link--color Политика конфиденциальности
					a(href="#").footer__links-el.link.link--color Пользовательское соглашение

				a(href="#" target="_blank").footer__dev.link.link--color Сделано в Xpage
