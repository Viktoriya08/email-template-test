.pa-body__search.pa-search.pa-search__wrapper 
	.pa-search__search
		input-search(placeholder="ФИО, телефон, e-mail клиента" id="pa-clients-search" :tooltips="['First tooltip', 'Second tooltip']")
	example-select(placeholder="Не выбрано" id="sale-select" label="По размеру скидки" :options="['Option 1', 'Extremely Long Option 2', 'Option 3']").pa-search__select

.pa-body__title 
	h2.title.title--h3 Список моих клиентов
	.pa-body__count 12 клиентов

	a(href="#").pa-body__title-link.link.link--color
		| Посмотреть все заказы в МойСклад
		+icon('arrow-link').link__icon

.pa-body__list 
	include client
	- for(let i=0; i<5; i++)
		+client()



.page-section__pagination
	big-pagination(arrows-style="simple" :total="100" :limit="15" :max-buttons="5")
