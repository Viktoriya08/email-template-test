section.page-section.products-slider(id="products-slider")
	.wrapper
		.page-section__top.page-section__top--border
			h2.page-section__title.title.title--h2 Аналоги на этот товар

			.page-section__controls.swiper-buttons
				button.swiper-button.swiper-button-prev
				button.swiper-button.swiper-button-next

		products-slider.products-slider__list(id="products-slider")
			template(#default)
				-for(var i = 0; i < 3; i ++)
					.swiper-slide.products-slider__item
						article.product-card.product-card--slide
							+image({
								src: 'img/catalog/product-1.webp',
								width: '430',
								height: '285'
							}).product-card__img

							.product-card__desc
								span.product-card__name Бампер передний под омыв. BMW 1 Series E81 / E87 07-11 (BM04047BBV / UBH01-23320H) Тайвань
								span.product-card__info Номер. HN04099BB
								.product-card__bages.bages
									span.bage.bage--small 2 шт в наличии
									base-tooltip.bage.bage--small
										span.bage__tooltip
											+icon('question').bage__icon
											| Дисконт

										template(#tooltip)
											span Дисконтный товар, это товар с небольшими визуальными дефектами, которые не влияют на работу. Благодаря этому товар может стоить дешевле.

							.product-card__actions
								.product-card__price.price
									.price__item.price__item--current
										span.price__item-price 23 000
										span.price__item-currency ₽

							a(href="#").product-card__link

					.swiper-slide.products-slider__item
						article.product-card.product-card--slide
							+image({
								src: 'img/catalog/product-temp.svg',
								width: '430',
								height: '285'
							}).product-card__img(itemprop="image")

							.product-card__desc
								span(itemprop="name").product-card__name Бампер (спойлер) задний нижняя часть Hyundai Solaris 17- (JH02-ACT17-022B / ST-HNS2-087S-0 / 01-H500-23) Китай
								span(itemprop="model").product-card__info Номер. HN04099BB
								.product-card__bages.bages
									span.bage.bage--small нет в наличии

							.product-card__actions
								.product-card__price.price
									.price__item.price__item--current(itemscope itemprop="offers" itemtype="http://schema.org/Offer")
										span(itemprop="price").price__item-price 23 000
										span(itemprop="priceCurrency" content="RUB").price__item-currency ₽
										meta(itemprop="availability" content="http://schema.org/InStock")

							a(href="#" itemprop="url").product-card__link

					.swiper-slide.products-slider__item
						article.product-card.product-card--slide
							+image({
								src: 'img/catalog/product-1.webp',
								width: '430',
								height: '285'
							}).product-card__img(itemprop="image")

							.product-card__desc
								span(itemprop="name").product-card__name Бампер передний под омыв. BMW 1 Series E81 / E87
								span(itemprop="model").product-card__info Номер. HN04099BB
								.product-card__bages.bages
									span.bage.bage--small 200 шт в наличии

							.product-card__actions
								.product-card__price.price
									.price__item.price__item--current(itemscope itemprop="offers" itemtype="http://schema.org/Offer")
										span(itemprop="price").price__item-price 23 000
										span(itemprop="priceCurrency" content="RUB").price__item-currency ₽
										meta(itemprop="availability" content="http://schema.org/InStock")

							a(href="#" itemprop="url").product-card__link

					.swiper-slide.products-slider__item
						article.product-card.product-card--slide
							+image({
								src: 'img/catalog/product-1.webp',
								width: '430',
								height: '285'
							}).product-card__img(itemprop="image")

							.product-card__desc
								span(itemprop="name").product-card__name Бампер передний под омыв. BMW 1 Series E81 / E87 07-11 (BM04047BBV / UBH01-23320H) Тайвань
								span(itemprop="model").product-card__info Номер. HN04099BB
								.product-card__bages.bages
									span.bage.bage--small 2 шт в наличии
									base-tooltip.bage.bage--small
										span.bage__tooltip
											+icon('question').bage__icon
											| Дисконт

										template(#tooltip)
											span Дисконтный товар, это товар с небольшими визуальными дефектами, которые не влияют на работу. Благодаря этому товар может стоить дешевле.

							.product-card__actions
								.product-card__price.price
									.price__item.price__item--current(itemscope itemprop="offers" itemtype="http://schema.org/Offer")
										span(itemprop="price").price__item-price 23 000
										span(itemprop="priceCurrency" content="RUB").price__item-currency ₽
										meta(itemprop="availability" content="http://schema.org/InStock")

							a(href="#" itemprop="url").product-card__link
