.product-cart
	.product-cart__price.price
		.price__item.price__item--current(itemscope itemprop="offers" itemtype="http://schema.org/Offer")
			span(itemprop="price").price__item-price 21 024
			span(itemprop="priceCurrency" content="RUB").price__item-currency ₽
			meta(itemprop="availability" content="http://schema.org/InStock")
		.price__item.price__item--old
			span.price__item-price 23 360
			span.price__item-currency ₽

	base-dropdown(is-fixed).product-cart__sale
		template(#trigger)
			button.sale-bage.sale-bage--dropdown
				span.sale-bage__text Ваша скидка 10%:
				span.sale-bage__count 2 336 ₽
				+icon('arrow-md-down').sale-bage__icon.dropdown__icon

		ul.dropdown__list
			li.dropdown__item
				.sale-bage__item
					span.sale-bage__text Ваша скидка 0%:
					span.sale-bage__count 0 ₽
			li.dropdown__item
				.sale-bage__item
					span.sale-bage__text Ваша скидка 5%:
					span.sale-bage__count 1 336 ₽
			li.dropdown__item
				.sale-bage__item.active
					span.sale-bage__text Ваша скидка 10%:
					span.sale-bage__count 2 336 ₽
			li.dropdown__item
				.sale-bage__item
					span.sale-bage__text Ваша скидка 15%:
					span.sale-bage__count 3 336 ₽
			li.dropdown__item
				.sale-bage__item
					span.sale-bage__text Ваша скидка 20%:
					span.sale-bage__count 4 336 ₽

	.product-cart__bages.bages
		span.bage 2 шт в наличии
		base-tooltip.bage
			span.bage__tooltip
				+icon('question').bage__icon
				| Дисконт

			template(#tooltip)
				span Дисконтный товар, это товар с небольшими визуальными дефектами, которые не влияют на работу. Благодаря этому товар может стоить дешевле.
